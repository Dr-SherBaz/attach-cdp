  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "attach-cdp": "bin/attach-cdp.mjs",
    "attach-cdp-mcp": "bin/attach-cdp-mcp.mjs"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
